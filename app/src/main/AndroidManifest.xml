<?xml version="1.0" encoding="utf-8"?>
<!-- Il package è definito da "namespace" in app/build.gradle (richiesto da AGP 8+) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Permesso dichiarato da AAIdrive (protectionLevel "normal"): serve per leggere i dati CDS
        (marcia, giri motore, ...) dal suo content provider. Viene concesso all'installazione,
        a patto che AAIdrive sia già installato: se installi Rally Gear PRIMA di AAIdrive,
        reinstalla Rally Gear.
    -->
    <uses-permission android:name="io.bimmergestalt.permission.CDS_normal" />

    <!-- Android 11+: senza questa dichiarazione il content provider di AAIdrive non è visibile -->
    <queries>
        <provider android:authorities="io.bimmergestalt.cardata.provider" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="Rally Gear"
        android:theme="@style/Theme.RallyGear">

        <!-- Schermata principale a tutto schermo sul telefono.
             Verticale al primo avvio. NESSUNA rotazione col sensore: l'orientamento (0°, 90°, 180°, 270°)
             si cambia solo a mano, con una pressione di 3,4 secondi sullo schermo (vedi MainActivity,
             che salva la scelta e la richiede con requestedOrientation).
             Lo schermo resta acceso (FLAG_KEEP_SCREEN_ON e keepScreenOn nel layout). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Rende l'app visibile nella scheda "Addons" di AAIdrive -->
        <service
            android:name=".RallyGearService"
            android:exported="true">
            <intent-filter>
                <action android:name="io.bimmergestalt.cardata.service" />
            </intent-filter>
        </service>

    </application>
</manifest>
