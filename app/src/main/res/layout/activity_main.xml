<?xml version="1.0" encoding="utf-8"?>
<!-- Layout VERTICALE (predefinito, anche capovolto a 180°): 5 LED in alto e marcia al centro.
     Con il telefono in orizzontale si usa res/layout-land/activity_main.xml (10 LED, velocità, temperature). -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- 5 LED Shift Light, distribuiti in modo uniforme su tutta la larghezza dello schermo:
         spazi di peso uguale tra i LED e ai due lati -->
    <LinearLayout
        android:id="@+id/ledBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <View android:id="@+id/led1" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/led_off" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <View android:id="@+id/led2" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/led_off" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <View android:id="@+id/led3" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/led_off" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <View android:id="@+id/led4" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/led_off" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <View android:id="@+id/led5" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/led_off" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
    </LinearLayout>

    <!-- Indicatore Marcia a 7 Segmenti Gigante -->
    <TextView
        android:id="@+id/tvGearDigit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="-"
        android:textColor="#FF0000"
        android:textSize="@dimen/text_size_gear"
        android:textStyle="bold"
        android:shadowColor="#FF0000"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="30" />

    <!-- Valori grezzi ricevuti dall'auto (debug), nell'angolo in basso a destra -->
    <TextView
        android:id="@+id/tvRaw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="12dp"
        android:text="gear=-  rpm=-"
        android:textColor="#555555"
        android:textSize="12sp" />

    <!-- Riga di stato della connessione con AAIdrive (grigio scuro, poco invadente).
         Occupa lo spazio a sinistra dei valori grezzi, anche su due righe, così non si sovrappone mai. -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/tvRaw"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_horizontal"
        android:maxLines="2"
        android:text="@string/status_waiting_aaidrive"
        android:textColor="#555555"
        android:textSize="12sp" />

</RelativeLayout>
