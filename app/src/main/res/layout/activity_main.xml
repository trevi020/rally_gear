<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- 5 LED Shift Light in Alto -->
    <LinearLayout
        android:id="@+id/ledBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View android:id="@+id/led1" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="10dp" android:background="@drawable/led_off" />
        <View android:id="@+id/led2" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="10dp" android:background="@drawable/led_off" />
        <View android:id="@+id/led3" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="10dp" android:background="@drawable/led_off" />
        <View android:id="@+id/led4" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="10dp" android:background="@drawable/led_off" />
        <View android:id="@+id/led5" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="10dp" android:background="@drawable/led_off" />
    </LinearLayout>

    <!-- Indicatore Marcia a 7 Segmenti Gigante -->
    <TextView
        android:id="@+id/tvGearDigit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="-"
        android:textColor="#FF0000"
        android:textSize="260sp"
        android:textStyle="bold"
        android:shadowColor="#FF0000"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="30" />

    <!-- Riga di stato della connessione con AAIdrive (grigio scuro, poco invadente) -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="8dp"
        android:text="In attesa di AAIdrive…"
        android:textColor="#555555"
        android:textSize="12sp" />

    <!-- Valori grezzi ricevuti dall'auto (debug), nell'angolo in basso a destra -->
    <TextView
        android:id="@+id/tvRaw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="12dp"
        android:text="gear=-  rpm=-"
        android:textColor="#555555"
        android:textSize="12sp" />

</RelativeLayout>
